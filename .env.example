# AWS Credentials (for local deployment scripts)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# ECR
ECR_REPOSITORY=123456789.dkr.ecr.us-east-1.amazonaws.com/myapp

# ECS
ECS_CLUSTER=myapp-staging
ECS_SERVICE=myapp-service

# EC2 (for SSH deployment)
EC2_HOST=1.2.3.4
EC2_USER=ubuntu

# S3 (for static site deployment)
S3_BUCKET=myapp-static-site
CLOUDFRONT_DISTRIBUTION_ID=E1234567890

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# App URLs (for smoke tests)
STAGING_URL=https://staging.example.com
PRODUCTION_URL=https://example.com
